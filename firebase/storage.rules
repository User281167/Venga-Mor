rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función centralizada para validar al colaborador
    function esColaboradorAutenticado(userId) {
      return request.auth != null
             && request.auth.uid == userId
             && request.auth.token.role == "admin";
    }

    // Perfiles: cada usuario solo puede escribir su propia foto
    match /perfiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 2 * 1024 * 1024; // 2MB limit
    }

    // --- SECCIÓN DE IMÁGENES ---
    // Estructura: images/{userId}/{postId}/{fileName}
    match /images/{userId}/{postId}/{fileName} {
      allow write: if esColaboradorAutenticado(userId)
                   && request.resource.size < 5 * 1024 * 1024 // 5MB
                   && request.resource.contentType.matches('image/.*'); // Solo imágenes

      // Abierto a cualquier logueado
      allow read: if request.auth != null;
    }

    // --- SECCIÓN DE VIDEOS ---
    // Estructura: videos/{userId}/{postId}/{fileName}
    match /videos/{userId}/{postId}/{fileName} {
      allow write: if esColaboradorAutenticado(userId)
                   && request.resource.size < 50 * 1024 * 1024 // 50MB
                   && request.resource.contentType.matches('video/.*'); // Solo videos

      allow read: if request.auth != null;
    }


    // ========================================
    // CHATS - TODO PERMITIDO (TEMPORAL)
    // ========================================
    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Bloqueo de seguridad por defecto para cualquier otra ruta
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
